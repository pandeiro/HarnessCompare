+function isPlainObject(value) {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function validate(tasks) {
+  if (!Array.isArray(tasks)) {
+    throw new PlanError("INVALID_TASKS", "tasks must be an array");
+  }
+
+  const byId = new Map();
+  for (let index = 0; index < tasks.length; index += 1) {
+    const task = tasks[index];
+    if (
+      !isPlainObject(task) ||
+      typeof task.id !== "string" ||
+      task.id.length === 0
+    ) {
+      throw new PlanError(
+        "INVALID_TASK",
+        `task at index ${index} must be a plain object with a non-empty string id`,
+        { index },
+      );
+    }
+    if (byId.has(task.id)) {
+      throw new PlanError("DUPLICATE_ID", `duplicate task id "${task.id}"`, {
+        id: task.id,
+      });
+    }
+    byId.set(task.id, task);
+  }
+
+  for (const task of tasks) {
+    if (task.deps === undefined) continue;
+    if (
+      !Array.isArray(task.deps) ||
+      !task.deps.every((dep) => typeof dep === "string" && dep.length > 0)
+    ) {
+      throw new PlanError(
+        "INVALID_DEPS",
+        `deps of task "${task.id}" must be an array of non-empty strings`,
+        { id: task.id },
+      );
+    }
+  }
+
+  for (const task of tasks) {
+    for (const dep of new Set(task.deps ?? [])) {
+      if (!byId.has(dep)) {
