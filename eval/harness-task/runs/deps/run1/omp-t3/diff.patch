+function isPlainObject(value) {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function isNonEmptyString(value) {
+  return typeof value === "string" && value.length > 0;
+}
+
+function validate(tasks) {
+  if (!Array.isArray(tasks)) {
+    throw new PlanError("INVALID_TASKS", "tasks must be an array");
+  }
+
+  const seen = new Set();
+  const depsById = new Map();
+
+  for (let index = 0; index < tasks.length; index++) {
+    const task = tasks[index];
+
+    if (!isPlainObject(task) || !isNonEmptyString(task.id)) {
+      throw new PlanError("INVALID_TASK", `task at index ${index} must be a plain object with a non-empty string id`, { index });
+    }
+
+    const { id, deps } = task;
+
+    if (seen.has(id)) {
+      throw new PlanError("DUPLICATE_ID", `duplicate task id "${id}"`, { id });
+    }
+    seen.add(id);
+
+    if (deps !== undefined) {
+      if (!Array.isArray(deps) || !deps.every(isNonEmptyString)) {
+        throw new PlanError("INVALID_DEPS", `deps for task "${id}" must be an array of non-empty strings`, { id });
+      }
+      depsById.set(id, new Set(deps));
+    } else {
+      depsById.set(id, new Set());
+    }
+  }
+
+  for (const [id, deps] of depsById) {
+    for (const dependency of deps) {
+      if (!seen.has(dependency)) {
+        throw new PlanError("UNKNOWN_DEP", `task "${id}" depends on unknown task "${dependency}"`, { id, dependency });
+      }
+    }
+  }
+
+  return depsById;
+}
+
 export function buildPlan(tasks) {
+  const depsById = validate(tasks);
+
